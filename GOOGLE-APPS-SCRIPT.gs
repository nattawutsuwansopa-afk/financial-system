const SHEET_ID = '18m8zbCevRoRoPQ_y3HVp-gJ1h2OOGZx_gyBNtoI7tTE';
const TABS = ['รายการ','เงินของหน่วย','ไปราชการ','บุคลากร','ผู้ใช้งาน','ประวัติ'];
const HEADERS = ['id','วันที่','ประเภท','รายละเอียด','จำนวนเงิน','ผู้ใช้งาน','ข้อมูลJSON','แก้ไขล่าสุด'];
function setup(){const ss=SpreadsheetApp.openById(SHEET_ID);TABS.forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0)s.appendRow(HEADERS);});}
function out(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){setup();const ss=SpreadsheetApp.openById(SHEET_ID),data={version:'5.4'};TABS.forEach(n=>{const s=ss.getSheetByName(n);data[n]=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,8).getValues():[];});return out(data);}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(10000);try{setup();const b=JSON.parse((e.postData&&e.postData.contents)||'{}'),tab=TABS.includes(b.tab)?b.tab:'รายการ',d=b.data||{},id=String(d.id||Utilities.getUuid()),s=SpreadsheetApp.openById(SHEET_ID).getSheetByName(tab),now=new Date();const row=[id,d.date||d.start||'',d.type||d.travelType||'',d.detail||d.mission||d.name||'',Number(d.amount||d.total||d.limit||0),d.user||'',JSON.stringify(Object.assign({},d,{id})),now];let target=0;if(s.getLastRow()>1){const ids=s.getRange(2,1,s.getLastRow()-1,1).getDisplayValues().flat();const i=ids.indexOf(id);if(i>=0)target=i+2;}if(target)s.getRange(target,1,1,8).setValues([row]);else s.appendRow(row);return out({ok:true,id,version:'5.4'});}catch(err){return out({ok:false,error:String(err)});}finally{lock.releaseLock();}}
